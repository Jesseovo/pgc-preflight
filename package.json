{
  "name": "pgc-preflight",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:agent": "tsx scripts/build-review-assistant.ts",
    "build": "npm run build:legacy && vite build --config vite.ui.config.ts && tsx scripts/assemble-frontend.ts",
    "test": "vitest run",
    "test:runtime": "tsx scripts/verify-runtime.ts",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "check:deploy": "wrangler deploy --dry-run",
    "dev:ui": "vite --config vite.ui.config.ts --host 127.0.0.1",
    "build:ui": "tsc --noEmit && vite build --config vite.ui.config.ts",
    "preview:ui": "tsx scripts/preview-looseleaf.ts",
    "test:ui": "tsx scripts/verify-looseleaf.ts",
    "build:legacy": "tsc --noEmit && tsx scripts/build-square-workspace.ts && npm run build:agent && vite build"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "overrides": {
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "^3.2.6"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
