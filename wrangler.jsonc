{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pgc-preflight",
  "account_id": "071443b43c7562efec975a5e964d5a9c",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CONTROL_PLANE", "class_name": "ReviewControlPlane" }, { "name": "REVIEW_RUNNER", "class_name": "ReviewRunner" }, { "name": "FORGE_RUNNER", "class_name": "ForgeRunner" }] },
  "migrations": [{ "tag": "v1-review-control", "new_sqlite_classes": ["ReviewControlPlane", "ReviewRunner"] }, { "tag": "v2-forge-runner", "new_sqlite_classes": ["ForgeRunner"] }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/", "/index.html", "/agent.md", "/forge-agent.md", "/admin", "/admin/", "/assets/*", "/forge", "/forge/*", "/review", "/review.html", "/review/*"], "not_found_handling": "single-page-application" },
  "browser": { "binding": "BROWSER" },
  "d1_databases": [{ "binding": "DB", "database_name": "pgc-preflight-db", "database_id": "0cd1de96-d7f1-413b-ab08-be461da99de0", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] },
  "ratelimits": [
    { "name": "CHECK_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "FORGE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "queues": {
    "producers": [{ "binding": "FORGE_QUEUE", "queue": "pgc-forge-jobs" }, { "binding": "REVIEW_QUEUE", "queue": "pgc-review-jobs" }],
    "consumers": [{ "queue": "pgc-forge-jobs", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "max_concurrency": 1 }, { "queue": "pgc-review-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 20 }]
  },
  "routes": [{ "pattern": "pgc.ovoxin.top", "custom_domain": true }],
  "observability": { "enabled": true }
}
